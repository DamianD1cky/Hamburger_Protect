# Explicit backend: local, nhost, supabase. Supabase is the production backend.
VITE_BACKEND=supabase
VITE_NHOST_SUBDOMAIN=your-project-subdomain
VITE_NHOST_REGION=your-project-region
# Fill the public Supabase client configuration for your target project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GM_ACCOUNT_DOMAIN=gm.local
