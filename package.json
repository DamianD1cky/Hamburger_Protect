{
  "name": "hamburger-protect",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "preview": "vite preview",
    "nhost:validate": "nhost config validate",
    "nhost:up": "nhost up",
    "setup:security": "sh scripts/setup-secret-scan.sh",
    "check:secrets": "gitleaks git --log-opts=--all --redact=100 --no-banner --no-color --max-archive-depth=2",
    "supabase:up": "supabase start",
    "supabase:status": "supabase status",
    "supabase:push": "supabase db push",
    "check:database": "node scripts/tests/database.mjs",
    "check:migration": "node scripts/tests/migration.mjs",
