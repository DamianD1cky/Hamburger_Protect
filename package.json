{
  "name": "hamburger-protect",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "preview": "vite preview",
    "setup:security": "sh scripts/setup-secret-scan.sh",
    "check:secrets": "gitleaks git --log-opts=--all --redact=100 --no-banner --no-color --max-archive-depth=2",
    "supabase:up": "supabase start",
    "supabase:status": "supabase status",
    "supabase:push": "node scripts/supabase-push-management.mjs",
    "supabase:push:dry": "node scripts/supabase-push-management.mjs --dry-run",
    "supabase:push:direct": "supabase db push",
    "check:access-ui": "node scripts/tests/access-ui.mjs",
    "check:site-admin": "node scripts/tests/site-admin.mjs",
    "check:site-admin-ui": "node scripts/tests/site-admin-ui.mjs",
    "check:motion-ui": "node scripts/tests/motion-ui.mjs",
    "check:accounts": "node --experimental-strip-types --test scripts/tests/accounts.mjs",
    "check:database": "node scripts/tests/database.mjs",
    "check:board-objects": "node scripts/tests/board-objects.mjs",
    "check:clock": "node --experimental-strip-types --test scripts/tests/campaign-clock.mjs",
    "check:dice": "node --experimental-strip-types scripts/tests/dice-engine.mjs && node --experimental-strip-types scripts/tests/dice-transport.mjs && node --experimental-strip-types scripts/tests/dice-geometry.mjs && node --experimental-strip-types scripts/tests/dice-assets.mjs && node --experimental-strip-types scripts/tests/dice-fan.mjs && node --experimental-strip-types scripts/tests/dice-selection.mjs",
    "check:migration": "node --experimental-strip-types scripts/tests/migration.mjs",
    "migration": "node scripts/migration/cli.mjs",
    "migration:gm-passwords": "node scripts/migration/migrate-gm-passwords.mjs"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.2",
    "cannon-es": "0.20.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "pg": "^8.23.1",
    "supabase": "^2.122.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
