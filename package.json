    "migration:gm-passwords": "node scripts/migration/migrate-gm-passwords.mjs"
  },
  "dependencies": {
    "@nhost/nhost-js": "^4.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.2",
    "lucide-react": "^1.57.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@nhost/cli": "^1.52.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "supabase": "^2.122.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
